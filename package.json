{
  "name": "loc-toolkit-api",
  "version": "0.3.0",
  "description": "REST API version of Loc Toolkit — stateless endpoints, async pipeline runs. Optionally backed by a real BullMQ/Redis queue, S3-compatible object storage, and Postgres.",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "worker": "node src/worker.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1109.0",
    "archiver": "^7.0.1",
    "better-sqlite3": "^11.3.0",
    "bullmq": "^5.12.0",
    "chardet": "^2.0.0",
    "express": "^4.19.2",
    "ioredis": "^5.4.1",
    "multer": "^1.4.5-lts.1",
    "pg": "^8.23.0",
    "unzipper": "^0.12.3",
    "uuid": "^10.0.0"
  }
}
